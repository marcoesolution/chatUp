{
  "name": "chatup",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --clear",
    "start:watch": "expo start --clear --watch",
    "android": "expo start --android --clear",
    "android:watch": "expo start --android --clear --watch",
    "android:fresh": "./scripts/kill-and-restart.sh && expo start --android --clear",
    "ios": "expo start --ios --clear",
    "web": "expo start --web --clear",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "install:fix": "npm install --legacy-peer-deps",
    "check:deps": "npx expo install --check",
    "build:android:apk": "eas build --platform android --profile production --local",
    "build:android:apk:cloud": "eas build --platform android --profile production",
    "build:android:aab": "eas build --platform android --profile production-aab --local",
    "build:android:aab:cloud": "eas build --platform android --profile production-aab",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production",
    "eas:setup": "eas build:configure",
    "eas:login": "eas login",
    "eas:logout": "eas logout",
    "eas:whoami": "eas whoami",
    "eas:env:list": "eas env:list",
    "eas:env:help": "echo 'Para adicionar variáveis de ambiente, use: eas env:create production --scope project --name NOME --value VALOR --type string --visibility plaintext --non-interactive'",
    "config:firebase": "./configurar-firebase.sh",
    "clean": "rm -rf node_modules && npm cache clean --force",
    "clean:build": "rm -rf android ios .expo",
    "clean:cache": "rm -rf .expo node_modules/.cache .metro .expo-shared dist",
    "clean:all": "npm run clean:cache && npm run clean:build && rm -rf node_modules && npm cache clean --force",
    "clean:expo": "npx expo start --clear",
    "reset": "npm run clean:all && npm install",
    "clean:device": "./scripts/clean-device.sh",
    "clean:full": "./scripts/clean-all.sh",
    "force:reload": "./scripts/force-reload.sh",
    "dev:android": "./scripts/force-reload.sh && npx expo start --android --clear --watch",
    "fresh:start": "./scripts/fresh-start.sh",
    "kill:expo": "./scripts/kill-and-restart.sh",
    "start:expo-go": "./scripts/start-expo-go.sh",
    "nuclear:reset": "./scripts/nuclear-reset.sh",
    "nuclear:start": "./scripts/nuclear-reset.sh && ./scripts/start-fresh.sh",
    "view:logs": "./scripts/view-logs.sh",
    "fix:network": "./scripts/fix-network.sh",
    "start:network": "EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0 npx expo start --android --clear",
    "start:tunnel": "./scripts/start-with-tunnel.sh",
    "test:minimal": "./scripts/test-minimal.sh",
    "restore:layout": "cp app/_layout.backup.tsx app/_layout.tsx",
    "fix:gradle": "./fix-gradle-build.sh",
    "build:android:apk:debug": "./capture-build-errors.sh",
    "build:android:apk:verbose": "EAS_LOCAL_BUILD_SKIP_CLEANUP=1 eas build --platform android --profile production --local --non-interactive",
    "update:production": "eas update --branch production --message \"$(git log -1 --pretty=%B | head -1)\"",
    "update:preview": "eas update --branch preview --message \"$(git log -1 --pretty=%B | head -1)\"",
    "update:check": "eas update:list",
    "update:branches": "eas channel:list",
    "update:create:production": "eas channel:create production",
    "update:info": "eas update:view",
    "update:delete": "eas update:delete",
    "update:list:all": "eas update:list --all",
    "update:clean": "./scripts/clean-eas-updates.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gannonh/firebase-mcp": "^1.4.9",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "^11.3.1",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-styled-components": "^2.1.4",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.9",
    "expo-crypto": "~15.0.7",
    "expo-linking": "~8.0.9",
    "expo-location": "~19.0.7",
    "expo-router": "~6.0.15",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.13",
    "expo-web-browser": "~15.0.9",
    "firebase": "^12.6.0",
    "react": "19.1.0",
    "react-hook-form": "^7.66.1",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.8.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/styled-components": "^5.1.34",
    "babel-preset-expo": "~54.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  },
  "private": true
}