# Firebase Configuration
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Firebase

# API Key do Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key-here

# Auth Domain do Firebase
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Project ID do Firebase
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Storage Bucket do Firebase
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Messaging Sender ID do Firebase
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# App ID do Firebase
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Measurement ID (Opcional - apenas se usar Google Analytics)
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# API URL (já existente no projeto)
EXPO_PUBLIC_API_URL=https://api.example.com
FIREBASE_SERVICE_ACCOUNT_PATH=$HOME/.firebase/chatup-ddcf8-service-account.json

# Google OAuth Configuration
# Obtenha o Web Client ID em: Firebase Console > Authentication > Sign-in method > Google > Web client ID
# Ou em: Google Cloud Console > APIs e Serviços > Credenciais > OAuth 2.0 Client IDs
# O Web Client ID é necessário para autenticação com Google no Expo
# Formato: geralmente começa com números, exemplo: 510679848324-xxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id-here
