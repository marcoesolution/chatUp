{
    "cli": {
        "version": ">= 5.2.0"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "node": "20.x.x"
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "node": "20.x.x"
        },
        "production": {
            "android": {
                "buildType": "apk"
            },
            "env": {
                "NODE_ENV": "production"
            },
            "node": "20.x.x"
        },
        "production-aab": {
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "NODE_ENV": "production"
            },
            "node": "20.x.x"
        }
    },
    "submit": {
        "production": {}
    }
}